# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# figures/ は追跡する（examples から再生成可能だが、GitHub で閲覧できるよう含める）

# 参照 PDF / zip（著作権物・大容量。ローカル保管のみ、コミットしない）
references/*.pdf
references/*.zip
references/*.docx

# LibreOffice / Word のロックファイル（gitignore は行内コメント不可なので独立行）
.~lock.*#
~$*

# OS / editor
.DS_Store
*.swp
